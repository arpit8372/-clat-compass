# ====================================================================
# CLAT Compass - Environment Variables
# Copy this file to .env.local and populate with your Supabase credentials
# ====================================================================

# Supabase Public API Credentials (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (Server-Only, NEVER expose to client)
# Used by Admin Server Actions to provision students without public signup
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Next.js Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
